create_rc_corner -name RC -cap_table {/home/cadence/install/FOUNDRY/digital/90nm/dig/captable/gpdk090.lef.extended.CapTbl} -preRoute_res {1.0} -preRoute_cap {1.0} -preRoute_clkres {0.0} -preRoute_clkcap {0.0} -postRoute_res {1.0} -postRoute_cap {1.0} -postRoute_xcap {1.0} -postRoute_clkres {0.0} -postRoute_clkcap {0.0} -qx_tech_file {/home/cadence/install/FOUNDRY/digital/90nm/dig/qrc/gpdk090_9l.tch}
create_library_set -name MAX -timing {/home/cadence/install/FOUNDRY/digital/90nm/dig/lib/slow.lib}
create_library_set -name MIN -timing {/home/cadence/install/FOUNDRY/digital/90nm/dig/lib/fast.lib}
create_constraint_mode -name CONSTRAINTS -sdc_files {snn_stdp.sdc}
create_delay_corner -name MAX_DELAY -library_set {MAX} -rc_corner {RC}
create_delay_corner -name MIN_DELAY -library_set {MIN} -rc_corner {RC}
create_analysis_view -name WORST_CASE -constraint_mode {CONSTRAINTS} -delay_corner {MAX_DELAY}
create_analysis_view -name BEST_CASE -constraint_mode {CONSTRAINTS} -delay_corner {MIN_DELAY}
set_analysis_view -setup {WORST_CASE} -hold {BEST_CASE}
